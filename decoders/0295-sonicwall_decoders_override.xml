<!-- \x3c and \x3e are the syslog priority brackets. ^\s* because events arrive
     with a variable number of leading spaces. -->
<decoder name="sonicwall">
  <prematch type="pcre2">^\s*(?:\x3c\d+\x3e\s*)?id=\S+\s+sn=\w+\s+time="[^"]+"\s+fw=\S+\s</prematch>
</decoder>

<!-- 1. Static fields formerly produced by SonicWall_Decoder -->
<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\spri=(\d+)</regex>
  <order>status</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\smsg="([^"]+)"</regex>
  <order>action</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\ssrc=(\d+\.\d+\.\d+\.\d+)</regex>
  <order>srcip</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\ssrc=\d+\.\d+\.\d+\.\d+:(\d+)</regex>
  <order>srcport</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sdst=(\d+\.\d+\.\d+\.\d+)</regex>
  <order>dstip</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sdst=\d+\.\d+\.\d+\.\d+:(\d+)</regex>
  <order>dstport</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sproto=(\S+)</regex>
  <order>protocol</order>
</decoder>

<!-- 2. Interface and hostname, the segments the plugin discarded -->
<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\ssrc=[^:\s]*:\d*:([^:\s]+):([^:\s]+)</regex>
  <order>sonicwall.src_iface, sonicwall.src_host</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\ssrc=[^:\s]*:\d*:([^:\s]+)(?=\s|$)</regex>
  <order>sonicwall.src_iface</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sdst=[^:\s]*:\d*:([^:\s]+):([^:\s]+)</regex>
  <order>sonicwall.dst_iface, sonicwall.dst_host</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sdst=[^:\s]*:\d*:([^:\s]+)(?=\s|$)</regex>
  <order>sonicwall.dst_iface</order>
</decoder>

<!-- 3. Zone transition -->
<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\srule="(\d+)\s+\(([^)]+)\)"</regex>
  <order>sonicwall.policy_id, sonicwall.zone_path</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\srule="\d+\s+\(([^)]+?)\x2d\x3e([^)]+)\)"</regex>
  <order>sonicwall.src_zone, sonicwall.dst_zone</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\srule=(\d+)(?=\s|$)</regex>
  <order>sonicwall.policy_id</order>
</decoder>

<!-- 4. Transport/service split so the service is matchable alone -->
<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sproto=([^/\s]+)/(\S+)</regex>
  <order>sonicwall.transport, sonicwall.service</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sproto=([^/\s]+)(?=\s|$)</regex>
  <order>sonicwall.service</order>
</decoder>

<!-- 5. Device and event context. Leading \s keeps m= off msg=, n= off sn=. -->
<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sm=(\d+)</regex>
  <order>sonicwall.msg_id</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sid=(\S+)</regex>
  <order>sonicwall.device_id</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\ssn=(\w+)</regex>
  <order>sonicwall.serial</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sfw=(\S+)</regex>
  <order>sonicwall.fw_ip</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sc=(\d+)</regex>
  <order>sonicwall.category</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sn=(\d+)</regex>
  <order>sonicwall.event_count</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sapp=(\d+)</regex>
  <order>sonicwall.app_id</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\stime="([^"]+)"</regex>
  <order>sonicwall.device_time</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\ssrcMac=([0-9a-fA-F:]+)</regex>
  <order>sonicwall.src_mac</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sdstMac=([0-9a-fA-F:]+)</regex>
  <order>sonicwall.dst_mac</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\susr="([^"]*)"</regex>
  <order>sonicwall.user</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\snote="([^"]*)"</regex>
  <order>sonicwall.note</order>
</decoder>

<!-- 6. IPv6 rides separate keys; src= and dst= are left empty on those -->
<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\ssrcV6=(\S+)</regex>
  <order>sonicwall.src_v6</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sdstV6=(\S+)</regex>
  <order>sonicwall.dst_v6</order>
</decoder>

<!-- 7. Web filter and App Control. Category is a quoted string. -->
<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sdstname=(\S+)</regex>
  <order>sonicwall.dst_name</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sCategory="([^"]*)"</regex>
  <order>sonicwall.cfs_category</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sappName="([^"]*)"</regex>
  <order>sonicwall.app_name</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sappcat="([^"]*)"</regex>
  <order>sonicwall.app_category</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sarg="([^"]*)"</regex>
  <order>sonicwall.url_path</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sarg=([^"\s]\S*)</regex>
  <order>sonicwall.url_path</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\scode=(\d+)</regex>
  <order>sonicwall.code</order>
</decoder>

<!-- 8. Session teardown, verdict, VPN, IPS -->
<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\ssent=(\d+)</regex>
  <order>sonicwall.bytes_sent</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\srcvd=(\d+)</regex>
  <order>sonicwall.bytes_rcvd</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sfw_action="([^"]*)"</regex>
  <order>sonicwall.fw_action</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\ssess="([^"]*)"</regex>
  <order>sonicwall.session_type</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sipscat="([^"]*)"</regex>
  <order>sonicwall.ips_category</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sipspri=(\d+)</regex>
  <order>sonicwall.ips_priority</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sif="([^"]*)"</regex>
  <order>sonicwall.iface</order>
</decoder>

<decoder name="sonicwall-fields">
  <parent>sonicwall</parent>
  <regex type="pcre2">\sifName="([^"]*)"</regex>
  <order>sonicwall.iface</order>
</decoder>
